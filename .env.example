# ── 팀 설정 ─────────────────────────────────────────
# 팀 이름 (헤더·탭 제목·앱 이름)
NEXT_PUBLIC_TEAM_NAME=JUST SHOOT
# 로고·앱 아이콘 글자. 영문·숫자 1~3자 (비우면 팀 이름 단어의 첫 글자들)
NEXT_PUBLIC_TEAM_SHORT=JS

# ── Supabase (대시보드 → Project Settings → API Keys) ──
# Project URL 은 https://xxxx.supabase.co 까지만 (/rest/v1/ 는 빼기)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable(anon) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key. 서버 전용 (NEXT_PUBLIC_ 붙이지 말 것, 채팅·저장소에 올리지 말 것)
SUPABASE_SECRET_KEY=

# ── 기록 관리 ───────────────────────────────────────
# /admin PIN (숫자)
ADMIN_PIN=
# (선택) 설정하면 Vercel Cron 만 /api/keepalive 를 호출할 수 있다
CRON_SECRET=
